FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv ca-certificates && rm -rf /var/lib/apt/lists/*
RUN npm install -g @openai/codex@0.163.0-alpha.11
RUN python3 -m venv /opt/venv && /opt/venv/bin/pip install --no-cache-dir 'fastapi>=0.115,<1' 'uvicorn>=0.30,<1'
ENV PATH="/opt/venv/bin:$PATH" CODEX_HOME=/home/node/.codex AI_WORK_DIR=/tmp/inference
WORKDIR /service
COPY app/planner/gateway.py ./gateway.py
USER node
EXPOSE 8091
CMD ["uvicorn", "gateway:app", "--host", "0.0.0.0", "--port", "8091", "--workers", "1"]
